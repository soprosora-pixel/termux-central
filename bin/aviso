#!/usr/bin/env bash
# Script para enviar notificações nativas no Android via termux-api

TITULO="${1:-Central Termux}"
MENSAGEM="${2:-Tarefa concluída com sucesso!}"

if command -v termux-notification &> /dev/null; then
    termux-notification --title "$TITULO" --content "$MENSAGEM" --priority high
    echo "Notificação enviada: [$TITULO] $MENSAGEM"
else
    echo "Erro: termux-api não está instalado ou configurado. Instale com: pkg install termux-api"
    exit 1
fi
