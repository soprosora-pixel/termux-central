#!/usr/bin/env python3
import datetime
import html
import json
import os
import re
import subprocess
import unicodedata
import urllib.error
import urllib.parse
import urllib.request

KEY = os.environ.get("GEMINI_API_KEY", "").strip()
if not KEY:
    print("Erro: GEMINI_API_KEY vazia. Rode: source ~/.bashrc")
    raise SystemExit(1)

HOME = os.path.expanduser("~")
MEM_GLOBAL = os.path.join(HOME, "MEMORIA.md")
UA = "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36"


def ler_texto_curto(caminho, limite=4000):
    try:
        if os.path.isfile(caminho):
            with open(caminho, "r", encoding="utf-8", errors="replace") as f:
                txt = f.read().strip()
            if len(txt) > limite:
                return txt[-limite:] + "\n[...truncado...]"
            return txt
    except Exception:
        pass
    return ""


def montar_contexto():
    cwd = os.getcwd()
    partes = [
        f"Diretório atual: {cwd}",
        f"Data/hora local: {datetime.datetime.now().strftime('%Y-%m-%d %H:%M')}",
    ]

    try:
        itens = sorted(os.listdir(cwd))[:40]
        partes.append("Arquivos na pasta atual: " + (", ".join(itens) if itens else "(vazia)"))
    except Exception:
        pass

    try:
        g = subprocess.run(
            ["git", "status", "-sb"],
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=5,
        )
        if g.returncode == 0 and g.stdout.strip():
            linhas = g.stdout.strip().splitlines()[:12]
            partes.append("Git status:\n" + "\n".join(linhas))
    except Exception:
        pass

    mem_g = ler_texto_curto(MEM_GLOBAL, 3500)
    if mem_g:
        partes.append(f"--- MEMORIA.md ({MEM_GLOBAL}) ---\n{mem_g}")

    for nome in ("MEMORIA.md", "GEMINI.md"):
        local = os.path.join(cwd, nome)
        if os.path.abspath(local) != os.path.abspath(MEM_GLOBAL):
            txt = ler_texto_curto(local, 2500)
            if txt:
                partes.append(f"--- {nome} (projeto atual) ---\n{txt}")

    return "\n\n".join(partes)


def construir_system_prompt(contexto):
    return (
        "Você é o Porteiro v2, o agente principal no Termux Android do Abel.\n"
        "Responda sempre em português, de forma direta, prática e sem enrolação.\n"
        "Seu objetivo é resolver o máximo possível sozinho com agilidade e economizar tokens do agente pesado 'agy'.\n\n"
        "Você tem 4 AÇÕES ESPECIAIS. Quando precisar usar uma ação, responda APENAS com uma única linha no formato exato abaixo (sem texto antes ou depois):\n"
        "1. Para executar um comando simples no Termux (ex: git status, ls, rclone, criar pasta/arquivo simples, checar sistema):\n"
        "   RODAR_CMD: <comando shell>\n"
        "2. Para ler o conteúdo de um arquivo local para analisar código, logs ou notas:\n"
        "   LER_ARQUIVO: <caminho_do_arquivo>\n"
        "3. Para pesquisar informações atualizadas na internet (docs Godot, erros recentes, APIs, notícias):\n"
        "   BUSCAR_WEB: <consulta de pesquisa curta com palavras-chave>\n"
        "4. SOMENTE para edições pesadas de código em vários arquivos ou refatorações complexas do jogo/projeto:\n"
        "   CHAMAR_AGY: <briefing técnico curto, cirúrgico e pronto para o agy executar>\n\n"
        "Se for conversa, dúvida, planejamento ou resposta após receber a saída de uma ferramenta, responda normalmente em texto.\n\n"
        "=== CONTEXTO ATUAL DO AMBIENTE ===\n"
        + contexto
    )


def chave_ordenacao_modelo(nome, preferir_lite=True):
    low = nome.lower()
    m = re.search(r"gemini-(\d+)\.(\d+)", low)
    ver = (int(m.group(1)), int(m.group(2))) if m else (0, 0)
    is_lite = 1 if "lite" in low else 0
    is_preview = 1 if ("preview" in low or "exp" in low) else 0
    lite_rank = (0 if is_lite else 1) if preferir_lite else (1 if is_lite else 0)
    return (lite_rank, -ver[0], -ver[1], is_preview, nome)


def descobrir_modelos():
    url = f"https://generativelanguage.googleapis.com/v1beta/models?key={KEY}"
    try:
        with urllib.request.urlopen(url, timeout=15) as r:
            dados = json.loads(r.read().decode("utf-8"))
        modelos = []
        for m in dados.get("models", []):
            nome = m.get("name", "").replace("models/", "")
            metodos = m.get("supportedGenerationMethods", [])
            low = nome.lower()
            if (
                "generateContent" in metodos
                and "flash" in low
                and "tts" not in low
                and "image" not in low
                and "audio" not in low
                and "live" not in low
                and "thinking" not in low
            ):
                modelos.append(nome)
        modelos.sort(key=lambda x: chave_ordenacao_modelo(x, preferir_lite=True))
        if modelos:
            return modelos
    except Exception:
        pass
    return ["gemini-3.5-flash-lite", "gemini-3.1-flash-lite", "gemini-2.5-flash"]


MODELS = descobrir_modelos()


def sem_acentos(texto):
    return "".join(
        c for c in unicodedata.normalize("NFKD", texto) if not unicodedata.combining(c)
    )


def preparar_consulta(consulta):
    lc = consulta.lower()
    if "godot" in lc and "godotengine" not in lc:
        consulta = "site:godotengine.org " + consulta
    limpa = re.sub(r"[?!\"'()\[\]{}]+", " ", consulta).strip()
    return limpa, [sem_acentos(p).lower() for p in limpa.split() if len(p) > 2]


def buscar_ddg_api(consulta_q):
    resultados = []
    try:
        q = urllib.parse.quote_plus(consulta_q)
        url = f"https://api.duckduckgo.com/?q={q}&format=json&no_html=1&skip_disambig=1"
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=12) as r:
            dados = json.loads(r.read().decode("utf-8"))
        if dados.get("AbstractText") and dados.get("AbstractURL"):
            url_abs = dados["AbstractURL"]
            if not any(bad in url_abs for bad in ("mail.google.com", "accounts.google.com")):
                resultados.append((
                    dados.get("Heading") or consulta_q,
                    url_abs,
                    dados["AbstractText"],
                ))
        for topic in dados.get("RelatedTopics", [])[:5]:
            if isinstance(topic, dict) and topic.get("Text") and topic.get("FirstURL"):
                url_t = topic["FirstURL"]
                if not any(bad in url_t for bad in ("mail.google.com", "accounts.google.com")):
                    resultados.append((topic["Text"][:80], url_t, topic["Text"]))
    except Exception:
        pass
    return resultados


def buscar_wikipedia(consulta_q, lang="en"):
    resultados = []
    try:
        q = urllib.parse.quote_plus(consulta_q)
        url = f"https://{lang}.wikipedia.org/w/api.php?action=query&list=search&srsearch={q}&srlimit=4&format=json&utf8=1"
        req = urllib.request.Request(url, headers={"User-Agent": "PorteiroTermux/2.0"})
        with urllib.request.urlopen(req, timeout=12) as r:
            dados = json.loads(r.read().decode("utf-8"))
        for item in dados.get("query", {}).get("search", []):
            titulo = item.get("title", "").strip()
            snippet = html.unescape(re.sub(r"<[^>]+>", "", item.get("snippet", ""))).strip()
            link = f"https://{lang}.wikipedia.org/wiki/{urllib.parse.quote(titulo.replace(' ', '_'))}"
            if titulo:
                resultados.append((f"{titulo} (Wikipedia {lang.upper()})", link, snippet))
    except Exception:
        pass
    return resultados


def buscar_web_direto(consulta):
    consulta_q, _ = preparar_consulta(consulta)
    combinados = []

    res_ddg = buscar_ddg_api(consulta_q)
    if res_ddg:
        combinados.extend(res_ddg)

    if len(combinados) < 3:
        for lang in ("en", "pt"):
            res_wiki = buscar_wikipedia(consulta_q, lang=lang)
            if res_wiki:
                combinados.extend(res_wiki)

    vistos = set()
    unicos = []
    for item in combinados:
        if item[1] not in vistos and not any(b in item[1] for b in ("mail.google.com", "accounts.google.com")):
            vistos.add(item[1])
            unicos.append(item)
    return unicos[:5]


def extrair_fontes(data):
    fontes = []
    try:
        meta = data["candidates"][0].get("groundingMetadata", {})
        for ch in meta.get("groundingChunks", []):
            web = ch.get("web", {})
            uri = web.get("uri")
            titulo = web.get("title") or uri
            if uri and not any(b in uri for b in ("mail.google.com", "accounts.google.com")) and (titulo, uri) not in fontes:
                fontes.append((titulo, uri))
    except Exception:
        pass
    return fontes[:5]


def perguntar(history, system_prompt, usar_grounding=False):
    payload = {
        "system_instruction": {"parts": [{"text": system_prompt}]},
        "contents": history[-16:],
    }
    if usar_grounding:
        payload["tools"] = [{"google_search": {}}]
        ordem = sorted(MODELS, key=lambda x: chave_ordenacao_modelo(x, preferir_lite=False))
    else:
        ordem = MODELS

    body = json.dumps(payload).encode("utf-8")
    ultimo_erro = ""
    for m in ordem:
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{m}:generateContent?key={KEY}"
        req = urllib.request.Request(
            url,
            data=body,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=35) as r:
                data = json.loads(r.read().decode("utf-8"))
            partes = data["candidates"][0]["content"].get("parts", [])
            texto = "\n".join(p.get("text", "") for p in partes if p.get("text")).strip()
            if not texto:
                continue
            fontes = extrair_fontes(data) if usar_grounding else []
            return texto, m, fontes
        except urllib.error.HTTPError as e:
            ultimo_erro = f"{m} ({e.code})"
            if e.code in (400, 404, 429, 500, 503):
                continue
            raise
        except Exception as e:
            ultimo_erro = f"{m} ({e})"
            continue
    raise RuntimeError(f"Modelos indisponíveis agora. Último: {ultimo_erro}")


def responder_com_web(consulta, hist, sys_prompt):
    print(f"\n🌐 [PESQUISANDO NA WEB]: {consulta}...")
    resultados = buscar_web_direto(consulta)
    if resultados:
        bloco = []
        fontes = []
        for idx, (titulo, link, desc) in enumerate(resultados, 1):
            bloco.append(f"{idx}. {titulo}\n   Link: {link}\n   Resumo: {desc}")
            fontes.append((titulo, link))
        prompt_web = (
            f"Resultados ao vivo da internet para '{consulta}':\n\n"
            + "\n".join(bloco)
            + "\n\nResponda à pergunta do usuário de forma direta em português usando esses resultados."
        )
        hist.append({"role": "user", "parts": [{"text": prompt_web}]})
        try:
            reply, usado, _ = perguntar(hist, sys_prompt, usar_grounding=False)
            hist.append({"role": "model", "parts": [{"text": reply}]})
            return reply, usado, fontes[:5]
        except Exception:
            hist.pop()
            raise

    hist.append({"role": "user", "parts": [{"text": f"Responda de forma direta em português: {consulta}"}]})
    try:
        reply, usado, fontes = perguntar(hist, sys_prompt, usar_grounding=True)
        hist.append({"role": "model", "parts": [{"text": reply}]})
        return reply, usado, fontes
    except Exception:
        try:
            reply, usado, _ = perguntar(hist, sys_prompt, usar_grounding=False)
            hist.append({"role": "model", "parts": [{"text": reply}]})
            return f"(Sem resultados web ao vivo agora — resposta do modelo)\n{reply}", usado, []
        except Exception:
            hist.pop()
            raise


def salvar_memoria(nota):
    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    with open(MEM_GLOBAL, "a", encoding="utf-8") as f:
        f.write(f"\n- [{ts}] {nota}\n")


def executar_shell(cmd):
    try:
        res = subprocess.run(
            cmd,
            shell=True,
            capture_output=True,
            text=True,
            timeout=60,
        )
        out = (res.stdout or "") + (("\n[STDERR]\n" + res.stderr) if res.stderr else "")
        out = out.strip() or "(comando executado sem saída)"
        if len(out) > 6000:
            out = out[:6000] + "\n[...truncado...]"
        return f"Código de saída: {res.returncode}\n{out}"
    except subprocess.TimeoutExpired:
        return "Erro: comando excedeu o limite de 60 segundos."
    except Exception as e:
        return f"Erro ao executar comando: {e}"


def mostrar_ajuda():
    print(
        "\nComandos rápidos do Porteiro v2:\n"
        "  /web <pergunta>   - Pesquisa na internet em tempo real com fontes\n"
        "  /lembrar <nota>   - Salva uma anotação permanente no ~/MEMORIA.md\n"
        "  /memoria          - Mostra suas últimas memórias salvas\n"
        "  /ler <arquivo>    - Lê um arquivo e coloca na conversa\n"
        "  /cmd <comando>    - Roda um comando e envia a saída pro Porteiro\n"
        "  /contexto         - Atualiza leitura da pasta e da memória\n"
        "  /limpar           - Limpa o histórico da conversa atual\n"
        "  sair              - Encerra o Porteiro\n"
    )


def main():
    contexto = montar_contexto()
    sys_prompt = construir_system_prompt(contexto)
    hist = []

    print("=== PORTEIRO v2 ATIVO (Memória + Web + Execução) ===")
    print(f"Pasta: {os.getcwd()}")
    print(f"Modelos: {', '.join(MODELS[:4])}")
    print(f"Memória: {'carregada' if os.path.isfile(MEM_GLOBAL) else 'nova (use /lembrar)'}")
    print("Digite '/ajuda' para ver os comandos ou 'sair' para encerrar.\n")

    while True:
        try:
            msg = input("Você > ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nPorteiro encerrado.")
            break

        if not msg:
            continue
        low = msg.lower()
        if low in ("sair", "exit", "quit"):
            print("Porteiro encerrado.")
            break

        if low == "/ajuda":
            mostrar_ajuda()
            continue

        if low == "/limpar":
            hist.clear()
            print("Histórico limpo.\n")
            continue

        if low == "/contexto":
            contexto = montar_contexto()
            sys_prompt = construir_system_prompt(contexto)
            print("Contexto da pasta e memória atualizado.\n")
            continue

        if low == "/memoria":
            txt = ler_texto_curto(MEM_GLOBAL, 2500)
            print("\n" + (txt if txt else "MEMORIA.md ainda vazio. Use: /lembrar <nota>") + "\n")
            continue

        if msg.startswith("/lembrar "):
            nota = msg[9:].strip()
            if nota:
                salvar_memoria(nota)
                contexto = montar_contexto()
                sys_prompt = construir_system_prompt(contexto)
                print("Salvo em ~/MEMORIA.md e carregado no contexto.\n")
            continue

        if msg.startswith("/ler "):
            caminho = os.path.expanduser(msg[5:].strip())
            conteudo = ler_texto_curto(caminho, 10000)
            if not conteudo:
                print(f"Arquivo não encontrado ou vazio: {caminho}\n")
                continue
            print(f"Arquivo '{caminho}' carregado ({len(conteudo)} caracteres).\n")
            hist.append({
                "role": "user",
                "parts": [{"text": f"Conteúdo do arquivo '{caminho}':\n```\n{conteudo}\n```\nAnalise brevemente e aguarde minha próxima instrução."}],
            })
            try:
                reply, usado, _ = perguntar(hist, sys_prompt)
                hist.append({"role": "model", "parts": [{"text": reply}]})
                print(f"Porteiro ({usado}) > {reply}\n")
            except Exception as e:
                print(f"[Erro]: {e}\n")
                hist.pop()
            continue

        if msg.startswith("/cmd "):
            cmd = msg[5:].strip()
            if cmd:
                saida = executar_shell(cmd)
                print(f"\n[SAÍDA]\n{saida}\n")
                hist.append({"role": "user", "parts": [{"text": f"Rodei o comando `{cmd}` e a saída foi:\n{saida}\nResuma o resultado de forma prática."}]})
                try:
                    reply, usado, _ = perguntar(hist, sys_prompt)
                    hist.append({"role": "model", "parts": [{"text": reply}]})
                    print(f"Porteiro ({usado}) > {reply}\n")
                except Exception as e:
                    print(f"[Erro]: {e}\n")
                    hist.pop()
            continue

        if msg.startswith("/web "):
            consulta = msg[5:].strip()
            if not consulta:
                continue
            try:
                reply, usado, fontes = responder_com_web(consulta, hist, sys_prompt)
                print(f"\nPorteiro ({usado}) > {reply}")
                if fontes:
                    print("\nFontes:")
                    for titulo, uri in fontes:
                        print(f"  - {titulo}: {uri}")
                print()
            except Exception as e:
                print(f"\n[Erro]: {e}\n")
            continue

        hist.append({"role": "user", "parts": [{"text": msg}]})

        for _passo in range(3):
            try:
                reply, usado, fontes = perguntar(hist, sys_prompt)
            except Exception as e:
                print(f"\n[Erro]: {e}\n")
                if hist and hist[-1]["role"] == "user":
                    hist.pop()
                break

            hist.append({"role": "model", "parts": [{"text": reply}]})

            if reply.startswith("BUSCAR_WEB:"):
                consulta = reply.replace("BUSCAR_WEB:", "", 1).strip()
                try:
                    reply_w, usado_w, fontes_w = responder_com_web(consulta, hist, sys_prompt)
                    print(f"\nPorteiro ({usado_w}) > {reply_w}")
                    if fontes_w:
                        print("\nFontes:")
                        for titulo, uri in fontes_w:
                            print(f"  - {titulo}: {uri}")
                    print()
                except Exception as e:
                    print(f"\n[Erro]: {e}\n")
                break

            if reply.startswith("LER_ARQUIVO:"):
                caminho = os.path.expanduser(reply.replace("LER_ARQUIVO:", "", 1).strip())
                print(f"\n📖 [LENDO ARQUIVO]: {caminho}")
                conteudo = ler_texto_curto(caminho, 10000)
                resultado = conteudo if conteudo else f"Arquivo não encontrado ou vazio: {caminho}"
                hist.append({"role": "user", "parts": [{"text": f"Resultado da leitura de '{caminho}':\n{resultado}\nAgora responda ao pedido original."}]})
                continue

            if reply.startswith("RODAR_CMD:"):
                cmd = reply.replace("RODAR_CMD:", "", 1).strip()
                print(f"\n🛠️  [COMANDO NO TERMUX] (via {usado})\nComando: {cmd}")
                try:
                    conf = input("Executar agora? (s/n) > ").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    conf = "n"
                if conf == "s":
                    saida = executar_shell(cmd)
                    print(f"\n[SAÍDA]\n{saida}\n")
                    hist.append({"role": "user", "parts": [{"text": f"Saída do comando `{cmd}`:\n{saida}\nExplique o resultado de forma curta e prática."}]})
                    continue
                else:
                    print("Execução cancelada.\n")
                    hist.append({"role": "user", "parts": [{"text": "O usuário cancelou a execução desse comando."}]})
                    break

            if reply.startswith("CHAMAR_AGY:"):
                tarefa = reply.replace("CHAMAR_AGY:", "", 1).strip()
                print(f"\n⚡ [AÇÃO PESADA PARA O AGY] (via {usado})\nBriefing: {tarefa}\n")
                try:
                    conf = input("Abrir agy agora? (s/n) > ").strip().lower()
                except (EOFError, KeyboardInterrupt):
                    conf = "n"
                if conf == "s":
                    try:
                        subprocess.run(["termux-clipboard-set"], input=tarefa.encode("utf-8"), check=False)
                        print("Briefing copiado! Só colar no agy.")
                    except Exception:
                        pass
                    subprocess.run(["agy"])
                    print("\n=== De volta ao Porteiro v2 ===\n")
                break

            print(f"\nPorteiro ({usado}) > {reply}")
            if fontes:
                print("\nFontes:")
                for titulo, uri in fontes:
                    print(f"  - {titulo}: {uri}")
            print()
            break


if __name__ == "__main__":
    new_version = "4.3"
if __name__ == "__main__":
    main()
